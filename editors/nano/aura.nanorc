# Aura syntax highlighting for nano.
# Install: add this line to ~/.nanorc
#   include "/path/to/aura-lang/editors/nano/aura.nanorc"

syntax aura "\.aura$"
comment "#"

# Numbers
color brightmagenta "\<[0-9]+(\.[0-9]+)?\>"

# Keywords
color brightblue "\<(import|as|type|enum|def|end|domain|new|assert|shadow|pub|cond|else)\>"
color brightcyan "\<(true|false|null)\>"

# Builtin functions
color cyan "\<(env|read_file|fail|range)\("

# Schema and enum names (capitalized identifiers)
color yellow "\<[A-Z][A-Za-z0-9_]*\>"

# Properties (the key before the colon)
color green "^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*[[:space:]]*:"

# Operators
color brightyellow "(\+|-|\*|/|%|==|!=|<=|>=|<|>|&&|\|\||!|\?|->)"

# Strings and interpolation
color brightgreen ""([^"\]|\\.)*""
color brightred "#\{[^}]*\}"

# Comments last, so they override anything inside them
color brightblack "(^|[[:space:]])#([^{].*)?$"

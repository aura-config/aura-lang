{
  "comments": { "lineComment": "#" },
  "brackets": [
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(domain|component|def|type|pub|cond|new)\\b.*$|.*(->|:)\\s*$|.*\\[\\s*$",
    "decreaseIndentPattern": "^\\s*(end|\\])\\s*$"
  }
}

{
  "name": "aura-lang",
  "displayName": "Aura",
  "description": "Aura configuration language: syntax highlighting + language server (live diagnostics)",
  "version": "0.1.0",
  "publisher": "aura-lang",
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:aura"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aura",
        "aliases": [
          "Aura",
          "aura"
        ],
        "extensions": [
          ".aura"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "aura",
        "scopeName": "source.aura",
        "path": "./syntaxes/aura.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Aura",
      "properties": {
        "aura.server.path": {
          "type": "string",
          "default": "aura-lsp",
          "description": "Path to the aura-lsp language server binary (looked up on PATH by default)."
        },
        "aura.server.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the Aura language server for live diagnostics."
        },
        "aura.registryDir": {
          "type": "string",
          "default": "",
          "description": "Directory of the cached package registry, used to jump into a registry import (`org/pkg@v1.2`). Defaults to ~/.aura/registry."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "scripts": {
    "package": "vsce package"
  }
}

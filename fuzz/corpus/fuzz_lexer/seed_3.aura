# Сборка i18n-каталога: переводчики работают с плоскими JSON,
# Aura валидирует и мержит. Runtime-плейсхолдеры {user} остаются строками.
# Запуск (из этого каталога): aura eval i18n.aura --allow-read=.

en = read_file("./locales/en.json").parse_json()
ru = read_file("./locales/ru.json").parse_json()

# В ru не должно быть ключей-сирот, отсутствующих в базовой локали
orphans = ru.keys().filter (k, i) -> !en.contains(k) end
# Внутри #{...} — обычный синтаксис выражений, кавычки не экранируются
assert orphans.len() == 0, "ru has orphan keys: #{orphans.join(", ")}"

locales:
  en: en
  # Fallback: непереведённые ключи остаются английскими (menu.settings)
  ru: en.merge(ru)
end

stats:
  total_keys:    en.len()
  translated_ru: ru.len()
end

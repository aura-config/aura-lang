# Каталог сервисов: данные берутся из существующих файлов проекта, а не дублируются.
# Запуск (из этого каталога): aura eval service_catalog.aura --allow-read=.

cargo = read_file("./Cargo.toml").parse_toml()
team  = read_file("./team.json").parse_json()

service:
  name:    cargo.package.name
  version: cargo.package.version
  owner:   team.teams[0].lead
  oncall:  team.get("oncall", "platform-team")
end

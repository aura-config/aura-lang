# Feature flags with a production guard: assert stops a dangerous combination
# before it deploys.
# Run: aura eval feature_flags.aura --allow-env=APP_ENV
# Try it: APP_ENV=production aura eval ... — you get E0530.

is_prod = env("APP_ENV", "dev") == "production"

experimental_checkout = true
new_search            = is_prod ? false : true

assert !(is_prod && experimental_checkout),
  "Experimental checkout must not be enabled in production"

flags:
  experimental_checkout: experimental_checkout
  new_search:            new_search
end

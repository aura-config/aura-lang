# A Telegram bot config: secrets through capabilities, commands with a schema,
# dev/prod modes and localisation — without a single repetition.
# Run:  aura eval bot.aura --allow-env=BOT_ENV
# Prod: BOT_ENV=production aura eval bot.aura --allow-env=BOT_ENV

bot_name = "aura_demo_bot"
is_prod  = env("BOT_ENV", "dev") == "production"

type Command
  command:     String
  description: String
end

def cmd(name, description)
  command:     name
  description: description
end

admin_ids = [187650342, 244179081]
assert admin_ids.uniq().len() == admin_ids.len(), "Duplicate admin ids"
assert admin_ids.len() >= 1, "Bot must have at least one admin"

bot:
  username: bot_name
  # The secret is NOT stored in the config and never reaches the JSON:
  # the application reads the token itself, from the variable named here
  token_env_var: "BOT_TOKEN"

  mode: is_prod ? "webhook" : "long_polling"
  webhook:
    url:           "https://bots.example.com/hooks/#{bot_name}"
    secret_header: "X-Telegram-Bot-Api-Secret-Token"
  end

  admins: admin_ids

  # A ready payload for setMyCommands; the schema catches a typo in a field
  menu_button: new Command
    command:     "help"
    description: "List of commands"
  end
  commands: [
    cmd("start", "Start working with the bot")
    cmd("help", "List of commands")
    cmd("subscribe", "Subscribe to notifications")
  ]

  limits:
    messages_per_minute: is_prod ? 20 : 100
    max_file_mb:         50
  end

  messages:
    "start.greeting":      "Hello! I am @#{bot_name}. Type /help."
    "errors.rate_limited": "Too fast. Please wait a minute."
  end
end

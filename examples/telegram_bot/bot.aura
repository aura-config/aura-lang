# Конфиг телеграм-бота: секреты через capabilities, команды со схемой,
# dev/prod-режимы и локализация — без единого повтора.
# Запуск: aura eval bot.aura --allow-env=BOT_ENV
# Прод:   BOT_ENV=production aura eval bot.aura --allow-env=BOT_ENV

bot_name = "aura_demo_bot"
is_prod  = env("BOT_ENV", "dev") == "production"

type Command
  command:     String
  description: String
end

def cmd(name, description)
  command:     name
  description: description
end

admin_ids = [187650342, 244179081]
assert admin_ids.uniq().len() == admin_ids.len(), "Duplicate admin ids"
assert admin_ids.len() >= 1, "Bot must have at least one admin"

bot:
  username: bot_name
  # Секрет НЕ хранится в конфиге и не попадает в JSON:
  # приложение само прочитает токен из переменной окружения по этому имени
  token_env_var: "BOT_TOKEN"

  mode: is_prod ? "webhook" : "long_polling"
  webhook:
    url:           "https://bots.example.com/hooks/#{bot_name}"
    secret_header: "X-Telegram-Bot-Api-Secret-Token"
  end

  admins: admin_ids

  # Готовый payload для setMyCommands; схема ловит опечатку в поле
  menu_button: new Command
    command:     "help"
    description: "Список команд"
  end
  commands: [
    cmd("start", "Начать работу с ботом")
    cmd("help", "Список команд")
    cmd("subscribe", "Подписаться на уведомления")
  ]

  limits:
    messages_per_minute: is_prod ? 20 : 100
    max_file_mb:         50
  end

  messages:
    "start.greeting":      "Привет! Я @#{bot_name}. Наберите /help."
    "errors.rate_limited": "Слишком часто. Подождите минуту."
  end
end

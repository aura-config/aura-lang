# =============================================================================
# Aura showcase 4 of several: a device provisioning profile.
#
# A fourth subject and a fourth shape: this one reads what other people wrote.
# The vendor ships board.toml, whoever wires the board maintains sensors.yaml,
# and neither is going to be rewritten in Aura. The manifest's job is to take
# them in, hold them to a schema, and emit what the flashing tool wants.
#
# Showcase 1 imports a helper, 2 is a chain of modules, 3 has no imports at
# all. This one has no Aura dependencies either — its inputs are foreign.
#
# Run: aura eval device.aura --allow-read=.
# =============================================================================

# --- Foreign input. Reading is a capability, denied unless granted (D1), and
# `check --hermetic` proves a manifest touches nothing before it ever runs.
board   = read_file("board.toml").parse_toml()
sensors = read_file("sensors.yaml").parse_yaml()

enum Bus
  "i2c"
  "spi"
end

type Sensor
  id:      String
  bus:     Bus
  poll_ms: Int
  topic:   String

  assert poll_ms >= 100, "polling faster than 100ms drains the battery"
  assert id.len() > 0, "a sensor needs an id"
end

type Board
  model:       String
  flash_mb:    Int
  sleep_ma:    Float
  battery_mah: Float

  assert flash_mb >= 4, "the image does not fit under 4 MB"
end

# --- Human-entered text is never trusted as written: one id arrives padded,
# one bus arrives upper-case, one topic arrives with a trailing slash.
clean_sensor = (raw) ->
  new Sensor
    id:      raw.id.trim()
    bus:     raw.bus.lower()
    poll_ms: raw.poll_ms
    # `slice` counts characters, so this is safe on a topic with non-ASCII in it.
    topic: raw.topic.ends_with("/") ? raw.topic.slice(0, raw.topic.len() - 1) : raw.topic
  end
end

wired = sensors.sensors.map (s, i) -> clean_sensor(s) end

board_info: new Board
  model:    board.board.model
  flash_mb: board.board.flash_mb
  sleep_ma: board.power.sleep_ma
  # The vendor writes 2000, so the TOML hands us an Int, but capacity is a
  # measurement and the schema says Float. There is no arithmetic here to
  # promote it (D6), so the widening is said out loud.
  battery_mah: board.power.battery_mah.to_float()
end

topic_list = wired.map (s, i) -> s.topic end

sensor_list: wired
topics:      topic_list

# --- Battery arithmetic, in Int where the figure is a count and Float where it
# is a rate. The language keeps them apart so neither rounds into the other.
awake_ma   = 80.0
duty_cycle = 0.02
average_ma = awake_ma * duty_cycle + board.power.sleep_ma
# Int / Float promotes to Float (D6). Where there is nothing to divide by,
# `to_float` widens on its own — there is no `Float.to_int()`, because
# narrowing would have to choose a rounding nobody asked for.
battery_days: (board.power.battery_mah / average_ma / 24.0).to_str()

# --- Output in the shape each consumer wants. One source of truth, three
# renderings, and none of them hand-maintained.
provisioning:
  as_json: wired.to_json()
  as_yaml: wired.to_yaml()
end

flash_manifest: board.board.to_toml()

# --- The init script the flashing tool runs. A block string keeps the shell
# verbatim, including its own `end`, and interpolates the values above (D16).
init_script: text
  #!/bin/sh
  set -e
  echo "flashing #{board.board.model} (#{board.board.flash_mb} MB)"
  for topic in #{topic_list.join(" ")}; do
    echo "subscribing $topic"
  done
  exec ./agent --sleep-ma #{board.power.sleep_ma}
end

assert wired.all (s, i) -> s.poll_ms >= 100 end, "every sensor must poll no faster than 100ms"

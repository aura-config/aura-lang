# A Kubernetes Deployment with a schema: a typo in the port's type is caught
# BEFORE kubectl apply.
# Run: aura eval k8s_deploy.aura --format yaml

type Container
  name:  String
  image: String
  port:  Int
end

app_name = "gateway"
version  = "2.4.1"

main_container = new Container
  name:  app_name
  image: "company/#{app_name}:#{version}"
  port:  8080
end

apiVersion: "apps/v1"
kind:       "Deployment"

metadata:
  name: app_name
  labels:
    "app.kubernetes.io/name":    app_name
    "app.kubernetes.io/version": version
  end
end

spec:
  replicas: 3
  template:
    spec:
      containers: [main_container]
    end
  end
end

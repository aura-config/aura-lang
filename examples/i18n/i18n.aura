# Assembling an i18n catalogue: translators work with flat JSON, Aura validates
# and merges it. Runtime placeholders like {user} stay as text.
# Run (from this directory): aura eval i18n.aura --allow-read=.

en = read_file("./locales/en.json").parse_json()
ru = read_file("./locales/ru.json").parse_json()

# ru must have no orphan keys — ones missing from the base locale
orphans = ru.keys().filter (k, i) -> !en.contains(k) end
# Inside #{...} the ordinary expression syntax applies; quotes need no escaping
assert orphans.len() == 0, "ru has orphan keys: #{orphans.join(", ")}"

locales:
  en: en
  # Fallback: untranslated keys stay English (menu.settings)
  ru: en.merge(ru)
end

stats:
  total_keys:    en.len()
  translated_ru: ru.len()
end

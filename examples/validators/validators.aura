# A package of validators (D12): pub items are the API for importers, while
# private helpers are invisible from outside.

pub type Service
  name: String
  port: Int
end

# A private helper: unavailable to an importer (E0309); declared before it is used
def valid_port(p)
  ok: p > 0 && p < 65536
end

pub def service(name, port)
  name: name
  port: valid_port(port).ok ? port : fail("invalid port #{port} for service '#{name}'")
end
